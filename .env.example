# Replace this placeholder for local runs. Never put a real competition salt here.
DAY1_SALT=replace-with-a-private-random-value

# Optional: when blank, JWT signing uses a key derived from DAY1_SALT.
JWT_SECRET=

# Local Compose database/cache settings.
POSTGRES_DB=nascon_league
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_secure_password
DATABASE_URL=postgresql://nascon:nascon_secure_password@postgres:5432/nascon_league
REDIS_URL=redis://redis:6379/0

# API listen and browser-origin settings.
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
