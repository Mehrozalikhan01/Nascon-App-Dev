# Set the exact team-provided salt from your NaSCon slip. Never commit the value.
DAY1_SALT=
DAY2_SALT=

# Optional: when blank, JWT signing uses a key derived from DAY1_SALT.
JWT_SECRET=

# Local Compose database/cache settings.
POSTGRES_DB=nascon_league
POSTGRES_USER=nascon
# Optional for a separate database secret. If blank, Compose uses DAY1_SALT.
POSTGRES_PASSWORD=
# Leave blank to use the PostgreSQL service created by Docker Compose.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Optional S3-compatible receipt archive. Compose defaults to the bundled MinIO.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nascon-local
MINIO_SECRET_KEY=
MINIO_BUCKET=nascon-receipts
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API listen and browser-origin settings.
PORT=8080
BIND_ADDRESS=127.0.0.1
HOST=0.0.0.0
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
